---
import { siteConfig } from "../config";

const iconMap: Record<string, string> = {
  seedling: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21c0-4-3-7-7-7 0 4 3 7 7 7zm0 0c0-4 3-7 7-7-4 0-7 3-7 7zm0 0V9m0 0c0-3.5 2.5-6 6-6-3.5 0-6 2.5-6 6z"/></svg>`,
  women: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>`,
  fund: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  innovation: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/></svg>`,
  circular: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3"/></svg>`,
};
---

<section id="expertise" class="py-20 px-6" style="background: var(--color-surface);">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14 reveal">
      <h2 class="text-3xl md:text-4xl font-bold font-heading" style="color: var(--color-primary-dark);">
        Lo Que Hago
      </h2>
      <div class="w-16 h-1 mt-4 mx-auto rounded-full" style="background: var(--color-accent);"></div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {siteConfig.expertise.map((item, i) => (
        <div
          class={`p-8 rounded-2xl bg-white card-hover reveal stagger-${(i % 3) + 1} ${i >= 3 ? 'md:col-span-1' : ''}`}
          style="border: 1px solid rgba(74, 124, 46, 0.1);"
        >
          <div
            class="w-14 h-14 rounded-xl flex items-center justify-center mb-5"
            style="background: var(--color-surface); color: var(--color-primary);"
            set:html={iconMap[item.icon] || iconMap.seedling}
          />
          <h3 class="text-lg font-bold font-heading mb-3" style="color: var(--color-primary-dark);">
            {item.title}
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-4">{item.description}</p>
          <div class="flex flex-wrap gap-2">
            {item.tags.map((tag) => (
              <span
                class="text-xs px-3 py-1 rounded-full font-medium skill-hover"
                style="background: var(--color-surface); color: var(--color-primary-dark);"
              >
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
import { siteConfig } from "../config";
---

<section id="hero" class="relative overflow-hidden" style="background: var(--color-surface-light);">
  <!-- Decorative leaf pattern -->
  <div class="absolute top-0 right-0 w-64 h-64 opacity-5" style="background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 opacity-5" style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);"></div>

  <div class="max-w-6xl mx-auto px-6 py-16 md:py-24">
    <div class="grid md:grid-cols-5 gap-10 items-center">
      <!-- Photo (2 cols) -->
      <div class="md:col-span-2 flex justify-center hero-photo">
        <div class="relative">
          <div
            class="absolute inset-0 rounded-2xl -rotate-3 scale-105"
            style="background: linear-gradient(135deg, var(--color-primary), var(--color-accent));"
          ></div>
          <img
            src="/profile.jpg"
            alt={siteConfig.name}
            class="relative rounded-2xl w-64 md:w-80 h-auto object-cover shadow-xl"
            loading="eager"
          />
        </div>
      </div>

      <!-- Content (3 cols) -->
      <div class="md:col-span-3 space-y-6">
        <div class="hero-title">
          <p class="text-sm font-semibold tracking-widest uppercase mb-2" style="color: var(--color-accent);">
            Ingeniera Agroindustrial · CIP {siteConfig.cip}
          </p>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight font-heading" style="color: var(--color-primary-dark);">
            Karina<br />Chunga Yesquén
          </h1>
        </div>

        <p class="hero-subtitle text-lg md:text-xl font-accent italic leading-relaxed" style="color: var(--color-primary);">
          {siteConfig.tagline}
        </p>

        <!-- Stats bar -->
        <div class="hero-stats flex flex-wrap gap-6 pt-2">
          {siteConfig.stats.map((stat) => (
            <div class="text-center">
              <div class="text-2xl md:text-3xl font-bold font-heading" style="color: var(--color-accent);">
                {stat.value}
              </div>
              <div class="text-xs text-gray-500 mt-1">{stat.label}</div>
            </div>
          ))}
        </div>

        <!-- Social + CTA -->
        <div class="hero-social flex flex-wrap items-center gap-4 pt-2">
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold text-white btn-hover"
            style="background: var(--color-primary-dark);"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Escríbeme
          </a>
          {siteConfig.social.linkedin && (
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full flex items-center justify-center border-2 icon-hover"
              style="border-color: var(--color-primary); color: var(--color-primary);"
              aria-label="LinkedIn"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          )}
          {siteConfig.social.instagram && (
            <a
              href={siteConfig.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full flex items-center justify-center border-2 icon-hover"
              style="border-color: var(--color-primary); color: var(--color-primary);"
              aria-label="Instagram"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Shimmer bar -->
  <div class="h-1 bar-shimmer"></div>
</section>

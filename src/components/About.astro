---
import { siteConfig } from "../config";

const paragraphs = siteConfig.aboutMe.split("\n\n");
---

<section id="sobre-mi" class="py-20 px-6" style="background: white;">
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-3 gap-12 items-start">
      <!-- Title column -->
      <div class="reveal-left">
        <h2 class="text-3xl md:text-4xl font-bold font-heading" style="color: var(--color-primary-dark);">
          Mi Historia
        </h2>
        <div class="w-16 h-1 mt-4 rounded-full" style="background: var(--color-accent);"></div>
      </div>

      <!-- Bio column -->
      <div class="md:col-span-1 space-y-4 reveal stagger-1">
        {paragraphs.map((p) => (
          <p class="text-gray-600 leading-relaxed">{p}</p>
        ))}
      </div>

      <!-- Quote column -->
      <div class="reveal-right stagger-2">
        <div
          class="relative p-8 rounded-2xl quote-float"
          style="background: var(--color-surface);"
        >
          <svg class="w-8 h-8 mb-4 opacity-30" style="color: var(--color-primary);" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <p class="text-xl md:text-2xl font-accent italic leading-relaxed" style="color: var(--color-primary-dark);">
            {siteConfig.quote.text}
          </p>
          <p class="mt-4 text-sm font-semibold" style="color: var(--color-accent);">
            — {siteConfig.quote.author}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
